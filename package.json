{
  "_comment": "========== 项目说明 ==========\n本项目是 SCADA 组态引擎（roc-wes）：基于 Vue 3 + AntV X6 的可视化工业监控系统，\n支持拖拽式画布编辑、多协议数据接入（WebSocket/MQTT/HTTP/SSE/Modbus/S7/OPC）、\n节点动画、路线编辑，并可打包为 Tauri 桌面应用。\n注意：package.json 是严格 JSON 格式不支持注释，因此用 _comment/_scripts 这类\nnpm 会忽略的字段来写说明。",
  "_scripts": "dev: 启动开发服务器；build: 先做 TS 类型检查再打包；preview: 预览打包产物。桌面端演示模式数据由 Tauri Rust 网关内置生成（npx tauri dev）",
  "name": "roc-wes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@antv/x6": "^3.1.7",
    "@antv/x6-vue-shape": "^3.0.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.18.1",
    "echarts": "^6.1.0",
    "mqtt": "^5.15.2",
    "pinia": "^3.0.4",
    "tslib": "^2.8.1",
    "vue": "^3.5.39",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.5"
  }
}
