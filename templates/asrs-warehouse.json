{
  "dataSources": [
    {
      "id": "tpl1-ds-ws",
      "name": "立库主数据源(WS)",
      "type": "websocket",
      "url": "ws://localhost:8080/ws",
      "description": "AS/RS 立库模板 - 堆垛机/输送线/提升机实时数据"
    },
    {
      "id": "tpl1-ds-modbus",
      "name": "提升机Modbus",
      "type": "modbus",
      "url": "ws://localhost:8086/modbus",
      "description": "AS/RS 立库模板 - 提升机寄存器数据",
      "config": {
        "demo": true
      }
    }
  ],
  "nodes": [
    {
      "id": "tpl1-stacker-01",
      "shape": "stacker-node",
      "x": 80,
      "y": 60,
      "width": 200,
      "height": 130,
      "data": {
        "name": "堆垛机-A01",
        "lane": "A01",
        "position": "03-08-02",
        "status": "idle",
        "isMoving": false,
        "progress": 0,
        "pointId": "device.stacker.1",
        "binding": {
          "sourceId": "tpl1-ds-ws",
          "points": [
            {
              "pointId": "device.stacker.1",
              "transformSource": "(raw) => { const v = Number(raw); if (v < 20) return { status: 'idle', isMoving: false, progress: 0 }; if (v < 60) return { status: 'running', isMoving: true, progress: ((v - 20) / 40) * 100 }; if (v < 80) return { status: 'warning', isMoving: false, progress: 0 }; return { status: 'error', isMoving: false, progress: 0 }; }"
            }
          ]
        }
      }
    },
    {
      "id": "tpl1-stacker-02",
      "shape": "stacker-node",
      "x": 80,
      "y": 260,
      "width": 200,
      "height": 130,
      "data": {
        "name": "堆垛机-A02",
        "lane": "A02",
        "position": "06-04-01",
        "status": "idle",
        "isMoving": false,
        "progress": 0,
        "pointId": "device.stacker.2",
        "binding": {
