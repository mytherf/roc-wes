    {
      "id": "tpl1-conveyor-01",
      "shape": "conveyor-node",
      "x": 680,
      "y": 60,
      "width": 220,
      "height": 80,
      "data": {
        "name": "入库输送线-01",
        "direction": "left",
        "isRunning": false,
        "status": "idle",
        "pointId": "device.conveyor.1",
        "binding": {
          "sourceId": "tpl1-ds-ws",
          "points": [
            {
              "pointId": "device.conveyor.1",
              "transformSource": "(raw) => { const v = Number(raw); if (v < 30) return { isRunning: false, status: 'idle' }; if (v < 70) return { isRunning: true, status: 'running' }; return { isRunning: false, status: 'error' }; }"
            }
