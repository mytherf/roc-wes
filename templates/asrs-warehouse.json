        "pointId": "device.rack.1",
        "binding": {
          "sourceId": "tpl1-ds-ws",
          "points": [
            {
              "pointId": "device.rack.1",
              "transformSource": "(_raw) => { const rows = 1; const cols = 6; const floors = 4; const newGrids = Array.from({ length: floors }, () => Array.from({ length: rows }, () => Array.from({ length: cols }, () => { const rand = Math.random(); const status = rand < 0.3 ? 'empty' : rand < 0.6 ? 'occupied' : 'reserved'; return { status }; }))); return { floorGrids: newGrids }; }"
            }
          ]
        }
      }
