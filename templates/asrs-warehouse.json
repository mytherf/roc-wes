    {
      "id": "tpl1-elevator-01",
      "shape": "elevator-node",
      "x": 960,
      "y": 120,
      "width": 120,
      "height": 160,
      "data": {
        "name": "提升机-01",
        "maxLevel": 6,
        "currentLevel": 1,
        "position": 0,
        "status": "idle",
        "pointId": "device.elevator.1",
        "binding": {
          "sourceId": "tpl1-ds-modbus",
          "points": [
            {
              "pointId": "device.elevator.1",
              "transformSource": "(raw) => { const v = Number(raw); const level = Math.floor(((v % 100) / 100) * 6) + 1; if (v < 30) return { currentLevel: level, position: v, status: 'idle' }; if (v < 80) return { currentLevel: level, position: v, status: 'running' }; return { currentLevel: level, position: v, status: 'error' }; }"
            }
          ]
        }
      }
    },
    {
      "id": "tpl1-gauge-01",
      "shape": "gauge-node",
      "x": 960,
      "y": 320,
      "width": 200,
      "height": 180,
      "data": {
        "title": "堆垛机负载",
        "unit": "%",
        "value": 50,
        "pointId": "sensor.temp.1",
        "binding": {
          "sourceId": "tpl1-ds-ws",
          "points": [
            {
              "pointId": "sensor.temp.1",
              "transformSource": "(raw) => Math.round(raw * 10) / 10"
            }
          ]
        }
      }
    },
    {
      "id": "tpl1-indicator-01",
      "shape": "indicator-node",
      "x": 680,
      "y": 420,
      "width": 130,
      "height": 70,
      "data": {
        "label": "A巷道状态",
        "value": "off",
        "pointId": "device.status.1",
        "binding": {
          "sourceId": "tpl1-ds-ws",
          "points": [
            {
              "pointId": "device.status.1",
              "transformSource": "(raw) => { if (raw > 80) return 'on'; if (raw > 50) return 'warning'; if (raw > 20) return 'off'; return 'error'; }"
            }
          ]
        }
      }
    },
    {
      "id": "tpl1-indicator-02",
      "shape": "indicator-node",
      "x": 850,
